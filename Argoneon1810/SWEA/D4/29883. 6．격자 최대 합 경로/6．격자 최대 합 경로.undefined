import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.StringTokenizer;

class Solution {
	public static void main(String args[]) throws Exception {
		new Solution().solve();
	}

	void solve() throws IOException {
		BufferedReader br = new BufferedReader(
				new InputStreamReader(System.in));
		int T;
		T = Integer.parseInt(br.readLine().trim());
		StringBuilder sb = new StringBuilder();
		for (int test_case = 1; test_case <= T; test_case++)
			sb.append('#').append(test_case)
					.append(' ').append(solveInner(br))
					.append('\n');
		System.out.print(sb);
	}

	String solveInner(BufferedReader br) throws IOException {
		StringTokenizer st = new StringTokenizer(br.readLine());
		int N, M;
		N = Integer.parseInt(st.nextToken());
		M = Integer.parseInt(st.nextToken());
		int[][] grid = new int[N][M];
		for(int r=0; r<N; ++r) {
			st = new StringTokenizer(br.readLine());
			for(int c=0; c<M; ++c) {
				grid[r][c] = Integer.parseInt(st.nextToken());
			}
		}
		int[][] score = new int[N][M];
		for(int r=0; r<N; ++r) {
			for(int c=0; c<M; ++c) {
				score[r][c] = grid[r][c];
				int cand1 = r-1 >= 0 ? score[r-1][c] : Integer.MIN_VALUE;
				int cand2 = c-1 >= 0 ? score[r][c-1] : Integer.MIN_VALUE;
				int maxRel = Integer.max(cand1, cand2);
				if(maxRel>=0)
					score[r][c] += maxRel;
			}
		}
		return Integer.toString(score[N-1][M-1]);
	}
}
